{
  "manifest_version": 3,
  "name": "Bili Cache",
  "version": "0.6.1",
  "description": "Cache Bilibili video and audio at the selected quality. Clear it when the tab closes or save a copy for 7 days.",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Bili Cache", "default_popup": "popup.html" },
  "permissions": ["activeTab", "scripting", "alarms"],
  "background": { "service_worker": "cleanup-worker.js" },
  "web_accessible_resources": [{ "resources": ["storage-frame.html"], "matches": ["https://www.bilibili.com/*"] }]
}
